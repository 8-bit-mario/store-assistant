# Copy to .env and fill in the blanks. .env is git-ignored; never commit real values.

# Required. The page shows an error naming any variable that is missing or blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Secret every lookup asks for. Choose your own.
STORE_LOOKUP_PASSPHRASE=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=store-assistant

# Optional. The values shown are the defaults.
# Directory for the SQLite files.
STORE_ASSISTANT_DATA_DIR=data
# Seconds an unanswered question waits before "Are you still there?".
STORE_ASSISTANT_CHECK_IN_SECONDS=60
# Seconds before an unanswered question is cancelled; must be greater than the check-in.
STORE_ASSISTANT_EXPIRE_SECONDS=90
